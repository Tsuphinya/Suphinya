{
  "expo": {
    "name": "Fortune Telling App",
    "slug": "fortune-telling-app",
    "version": "1.0.0",
    "scheme": "fortunetelling",
    "orientation": "portrait",
    "icon": "./assets/splash.png",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yourname.fortunetelling"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a0033"
      },
      "package": "com.yourname.fortunetelling",
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "แอปต้องการเข้าถึงรูปภาพของคุณเพื่อตั้งรูปโปรไฟล์",
          "cameraPermission": "แอปต้องการเข้าถึงกล้องของคุณเพื่อถ่ายรูปโปรไฟล์"
        }
      ],
      "expo-web-browser",
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#1a0033"
        }
      ],
      "expo-asset"
    ]
  }
}
